<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>


<?import java.lang.String?>
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      styleClass="app-root"
      stylesheets="@Application.css"
      prefWidth="1100" prefHeight="740" minWidth="900" minHeight="640"
      spacing="10">

    <padding>
        <Insets top="14" right="18" bottom="14" left="18"/>
    </padding>

    <!-- ================= HEADER ================= -->
    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="header">
        <Label text="🗂" styleClass="app-icon"/>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Duplicate File Finder" styleClass="app-title"/>
            <Label text="Find and remove duplicate files to free up disk space" styleClass="app-subtitle"/>
        </VBox>
    </HBox>

    <!-- ================= SCAN CONTROLS ================= -->
    <VBox spacing="10" styleClass="panel">
        <padding>
            <Insets top="10" right="12" bottom="10" left="12"/>
        </padding>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Select Folder:" styleClass="bold-label"/>
            <TextField fx:id="folderPathField" promptText="Choose a folder to scan..." HBox.hgrow="ALWAYS"/>
            <Button fx:id="browseButton" text="📂  Browse..." styleClass="secondary-button"/>

            <Separator orientation="VERTICAL"/>

            <Label text="File Types (Optional):" styleClass="bold-label"/>
            <ComboBox fx:id="fileTypeCombo" prefWidth="200">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="All Files    (.)" />
                        <String fx:value="Images (.jpg, .jpeg, .png, .gif, .bmp, .webp, .svg, .tiff)" />
                        <String fx:value="Videos (.mp4, .mkv, .avi, .mov, .wmv, .flv, .webm, .m4v)" />
                        <String fx:value="Audio (.mp3, .wav, .flac, .aac, .ogg, .m4a, .wma)" />
                        <String fx:value="Documents (.pdf, .doc, .docx, .txt, .rtf, .odt)" />
                        <String fx:value="Spreadsheets (.xls, .xlsx, .csv, .ods)" />
                        <String fx:value="Presentations (.ppt, .pptx, .odp)" />
                        <String fx:value="Archives (.zip, .rar, .7z, .tar, .gz, .bz2)" />
                        <String fx:value="Executables (.exe, .msi, .bat, .cmd, .jar)" />
                        <String fx:value="Code/Source (.java, .kt, .c, .cpp, .h, .py, .js, .html, .css, .json, .xml)" />
                    </FXCollections>
                </items>
                <value>
                    <String fx:value="All Files (*.*)"/>
                </value>
            </ComboBox>

            <Button fx:id="scanButton" text="▶   Scan Now" styleClass="primary-button" prefWidth="220"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label fx:id="scanStatusLabel" text="Scanning..." styleClass="bold-label" minWidth="90"/>
            <ProgressBar fx:id="scanProgressBar" progress="0.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Label fx:id="progressPercentLabel" text="0%" minWidth="40"/>
            <Button fx:id="stopButton" text="■  Stop" styleClass="secondary-button" prefWidth="120"/>
        </HBox>
    </VBox>

    <!-- ================= RESULTS ================= -->
    <VBox spacing="6" styleClass="panel" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="8" right="8" bottom="8" left="8"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="📄" styleClass="section-icon"/>
            <Label text="Duplicate Files Found" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="4">
                <Label text="Total Groups:"/>
                <Label fx:id="totalGroupsLabel" text="0"/>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="4">
                <Label text="Total Duplicate Files:"/>
                <Label fx:id="totalDuplicateFilesLabel" text="0"/>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="4">
                <Label text="Total Wasted Space:"/>
                <Label fx:id="totalWastedSpaceLabel" text="0 MB"/>
            </HBox>
        </HBox>

        <!-- Rows are supplied by backend: hidden root -> group items -> file items -->
        <TreeTableView fx:id="resultsTable"
                       showRoot="false"
                       VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="No duplicates found yet. Select a folder and click Scan Now."
                       styleClass="placeholder-label"/>
            </placeholder>
            <columns>
                <TreeTableColumn fx:id="selectColumn" prefWidth="60" minWidth="50" maxWidth="70"
                                 sortable="false" resizable="false">
                    <graphic>
                        <CheckBox fx:id="selectAllCheckBox"/>
                    </graphic>
                </TreeTableColumn>
                <TreeTableColumn fx:id="indexColumn" text="#" prefWidth="60" sortable="false"/>
                <TreeTableColumn fx:id="fileNameColumn" text="File Name" prefWidth="260"/>
                <TreeTableColumn fx:id="filePathColumn" text="File Path" prefWidth="360"/>
                <TreeTableColumn fx:id="fileSizeColumn" text="File Size" prefWidth="110"/>
                <TreeTableColumn fx:id="lastModifiedColumn" text="Last Modified" prefWidth="170"/>
                <TreeTableColumn fx:id="hashColumn" text="Hash (SHA-256)" prefWidth="200"/>
            </columns>
        </TreeTableView>
    </VBox>

    <!-- ================= BOTTOM PANELS ================= -->
    <HBox spacing="10" prefHeight="190" minHeight="190" maxHeight="190">

        <!-- Scan Summary -->
        <VBox spacing="8" styleClass="panel" prefWidth="320" minWidth="280">
            <padding>
                <Insets top="10" right="14" bottom="10" left="14"/>
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="◔" styleClass="summary-icon"/>
                <Label text="Scan Summary" styleClass="section-title"/>
            </HBox>
            <GridPane hgap="30" vgap="6">
                <columnConstraints>
                    <ColumnConstraints minWidth="130"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Files Scanned:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="filesScannedLabel" text="0" styleClass="bold-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Duplicate Groups:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="summaryGroupsLabel" text="0" styleClass="bold-label"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Total Duplicate Files:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="summaryDuplicateFilesLabel" text="0" styleClass="bold-label"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Wasted Space:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="summaryWastedSpaceLabel" text="0 MB" styleClass="wasted-label"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>

        <!-- Scan Log -->
        <VBox spacing="6" styleClass="panel" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="10" right="12" bottom="10" left="12"/>
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="📋" styleClass="summary-icon"/>
                <Label text="Scan Log" styleClass="section-title"/>
            </HBox>
            <TextArea fx:id="scanLogArea" editable="false" wrapText="false"
                      styleClass="log-area" VBox.vgrow="ALWAYS"/>
        </VBox>

        <!-- Actions -->
        <VBox spacing="8" styleClass="panel" prefWidth="300" minWidth="260">
            <padding>
                <Insets top="10" right="12" bottom="10" left="12"/>
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="🗑" styleClass="summary-icon"/>
                <Label text="Actions" styleClass="section-title"/>
            </HBox>
            <Button fx:id="deleteSelectedButton" text="🗑   Delete Selected"
                    styleClass="danger-button" maxWidth="Infinity"/>
            <Button fx:id="autoSelectButton" text="✔✔  Auto-Select All But One"
                    styleClass="secondary-button" maxWidth="Infinity"/>
            <Button fx:id="rescanButton" text="⟳   Rescan"
                    styleClass="secondary-button" maxWidth="Infinity"/>
        </VBox>
    </HBox>
</VBox>
